{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Distribution API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Distribution",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Distribute Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/distribution/:name/:version",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Distributes a signed release bundle to target edge nodes."
        },
        {
          "info": {
            "name": "JFrog Get Distribution Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/distribution/:name/:version/status",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ]
          },
          "docs": "Returns the distribution status for a release bundle version."
        },
        {
          "info": {
            "name": "JFrog Delete Distributed Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/distribution/:name/:version/delete",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes a distributed release bundle from target edge nodes."
        },
        {
          "info": {
            "name": "JFrog Distribute Release Bundle v2",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v2/release_bundle/distribute/:name/:version",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Distributes a release bundle to specified edge nodes."
        },
        {
          "info": {
            "name": "JFrog Get Distribution Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v2/release_bundle/distribute/:name/:version/status",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ]
          },
          "docs": "Returns distribution status for a release bundle."
        }
      ]
    }
  ],
  "bundled": true
}