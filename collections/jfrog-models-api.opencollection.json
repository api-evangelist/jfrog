{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Models API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/models",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset for pagination"
              }
            ]
          },
          "docs": "Returns a list of all registered ML models."
        },
        {
          "info": {
            "name": "JFrog Create Model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/models",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Registers a new ML model in the model registry."
        },
        {
          "info": {
            "name": "JFrog Get Model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/models/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ]
          },
          "docs": "Returns details for a specific model."
        },
        {
          "info": {
            "name": "JFrog Update Model",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{server}.jfrog.io/access/v1/models/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates model metadata."
        },
        {
          "info": {
            "name": "JFrog Delete Model",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/v1/models/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ]
          },
          "docs": "Deletes a model and all its versions."
        }
      ]
    }
  ],
  "bundled": true
}