{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Groups API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/api/v2/groups"
          },
          "docs": "Returns a list of all groups configured in the Access service."
        },
        {
          "info": {
            "name": "JFrog Create Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/api/v2/groups",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new group in the Access service for organizing users and assigning permissions."
        },
        {
          "info": {
            "name": "JFrog Get Group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/api/v2/groups/:groupName",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ]
          },
          "docs": "Returns details for a specific group, including its members."
        },
        {
          "info": {
            "name": "JFrog Update Group",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{server}.jfrog.io/access/api/v2/groups/:groupName",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates group properties. Only provided fields are modified."
        },
        {
          "info": {
            "name": "JFrog Delete Group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/api/v2/groups/:groupName",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ]
          },
          "docs": "Deletes a group and removes all user associations."
        },
        {
          "info": {
            "name": "JFrog List Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/access/api/v2/groups"
          },
          "docs": "Returns a list of all platform groups."
        },
        {
          "info": {
            "name": "JFrog Create Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/access/api/v2/groups",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new platform group."
        },
        {
          "info": {
            "name": "JFrog Get Group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/access/api/v2/groups/:groupName",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ]
          },
          "docs": "Returns details for a specific group."
        },
        {
          "info": {
            "name": "JFrog Update Group",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{server}.jfrog.io/access/access/api/v2/groups/:groupName",
            "params": [
              {
                "name": "groupName",
                "value": "",
                "type": "path",
                "description": "Group name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates group details."
        },
        {
          "info": {
            "name": "JFrog Delete Group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/access/api/v2/groups/:groupName",
            "params": [
              {
                "name": "groupName",
                "value": "",
