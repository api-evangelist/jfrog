                "description": "Username"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates properties of an existing user. Only provided fields are updated."
        },
        {
          "info": {
            "name": "JFrog Delete User",
