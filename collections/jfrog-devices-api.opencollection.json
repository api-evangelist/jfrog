{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Devices API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Devices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/projects/:projectId/devices",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by device status"
              },
              {
                "name": "group_id",
                "value": "",
                "type": "query",
                "description": "Filter by device group"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              }
            ]
          },
          "docs": "Returns a list of all devices in a project."
        },
        {
          "info": {
            "name": "JFrog Get Device",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/projects/:projectId/devices/:deviceId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "Device ID"
              }
            ]
          },
          "docs": "Returns details for a specific device."
        },
        {
          "info": {
            "name": "JFrog Remove Device",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/projects/:projectId/devices/:deviceId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "Device ID"
              }
            ]
          },
          "docs": "Removes a device from the project."
        }
      ]
    }
  ],
  "bundled": true
}