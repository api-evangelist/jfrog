{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Audit API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Get Curation Audit Log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/audit",
            "params": [
              {
                "name": "from_date",
                "value": "",
                "type": "query",
                "description": "Start date for the audit log query"
              },
              {
                "name": "to_date",
                "value": "",
                "type": "query",
                "description": "End date for the audit log query"
              },
              {
                "name": "package_type",
                "value": "",
                "type": "query",
                "description": "Filter by package type (npm, maven, pypi, etc.)"
              },
              {
                "name": "policy_name",
                "value": "",
                "type": "query",
                "description": "Filter by policy name"
              },
              {
                "name": "action_taken",
                "value": "",
                "type": "query",
                "description": "Filter by action taken"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset for pagination"
              }
            ]
          },
          "docs": "Returns the curation audit log showing blocked and allowed packages."
        }
      ]
    }
  ],
  "bundled": true
}