{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Reports API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Generate Vulnerability Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/report/vulnerabilities",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a vulnerability report for specified scope."
        },
        {
          "info": {
            "name": "JFrog Get Report Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/report/:reportId",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path",
                "description": "Report ID"
              }
            ]
          },
          "docs": "Returns the status and details of a report."
        },
        {
          "info": {
            "name": "JFrog Delete Report",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/v1/report/:reportId",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path",
                "description": "Report ID"
              }
            ]
          },
          "docs": "Deletes a generated report."
        }
      ]
    }
  ],
  "bundled": true
}