{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Model Versions API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Model Versions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Model Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/models/:modelId/versions",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ]
          },
          "docs": "Returns all versions for a specific model."
        },
        {
          "info": {
            "name": "JFrog Create Model Version",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/models/:modelId/versions",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new version for a model."
        },
        {
          "info": {
            "name": "JFrog Get Model Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/models/:modelId/versions/:versionId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID"
              },
              {
                "name": "versionId",
                "value": "",
                "type": "path",
                "description": "Version ID"
              }
            ]
          },
          "docs": "Returns details for a specific model version."
        },
        {
          "info": {
            "name": "JFrog Delete Model Version",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/v1/models/:modelId/versions/:versionId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path",
                "description": "Model ID"
              },
              {
                "name": "versionId",
                "value": "",
                "type": "path",
                "description": "Version ID"
              }
            ]
          },
          "docs": "Deletes a specific model version."
        }
      ]
    }
  ],
  "bundled": true
}