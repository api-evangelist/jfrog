{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Access Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Access Tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/access/api/v2/tokens"
          },
          "docs": "Returns a list of all access tokens."
        },
        {
          "info": {
            "name": "JFrog Create Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/access/api/v2/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new access token."
        },
        {
          "info": {
            "name": "JFrog Get Token Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/access/api/v2/tokens/:tokenId",
            "params": [
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "Token ID"
              }
            ]
          },
          "docs": "Returns details for a specific access token."
        },
        {
          "info": {
            "name": "JFrog Revoke Access Token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/access/api/v2/tokens/:tokenId",
            "params": [
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "Token ID"
              }
            ]
          },
          "docs": "Revokes an access token."
        }
      ]
    }
  ],
  "bundled": true
}