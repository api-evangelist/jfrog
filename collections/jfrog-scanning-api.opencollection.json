{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Scanning API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scanning",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Scan Build (v2)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v2/ci/scan",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Triggers an on-demand scan for a build."
        },
        {
          "info": {
            "name": "JFrog Scan Artifact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/scanArtifact",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Triggers a scan for a specific artifact by its component ID."
        }
      ]
    }
  ],
  "bundled": true
}