{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Repositories API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Repositories",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List All Repositories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/api/repositories",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by repository type"
              },
              {
                "name": "packageType",
                "value": "",
                "type": "query",
                "description": "Filter by package type (e.g., maven, npm, docker)"
              }
            ]
          },
          "docs": "Returns a list of all repositories with minimal information."
        },
        {
          "info": {
            "name": "JFrog Get Repository Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/api/repositories/:repoKey",
            "params": [
              {
                "name": "repoKey",
                "value": "",
                "type": "path",
                "description": "Repository key"
              }
            ]
          },
          "docs": "Returns the full configuration for a specific repository."
        },
        {
          "info": {
            "name": "JFrog Update Repository Configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/api/repositories/:repoKey",
            "params": [
              {
                "name": "repoKey",
                "value": "",
                "type": "path",
                "description": "Repository key"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates configuration of an existing repository."
        },
        {
          "info": {
            "name": "JFrog Create Repository",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{server}.jfrog.io/access/api/repositories/:repoKey",
            "params": [
              {
                "name": "repoKey",
                "value": "",
                "type": "path",
                "description": "Repository key"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new repository with the specified configuration."
        },
        {
          "info": {
            "name": "JFrog Delete Repository",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/api/repositories/:repoKey",
            "params": [
              {
                "name": "repoKey",
                "value": "",
                "type": "path",
                "description": "Repository key"
              }
            ]
          },
          "docs": "Removes a repository configuration and optionally deletes its content."
        }
      ]
    }
  ],
  "bundled": true
}