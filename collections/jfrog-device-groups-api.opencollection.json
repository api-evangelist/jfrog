{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Device Groups API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Device Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Device Groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/projects/:projectId/device-groups",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              }
            ]
          },
          "docs": "Returns all device groups in a project."
        },
        {
          "info": {
            "name": "JFrog Create Device Group",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/projects/:projectId/device-groups",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new device group."
        },
        {
          "info": {
            "name": "JFrog Get Device Group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/projects/:projectId/device-groups/:groupId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Group ID"
              }
            ]
          },
          "docs": "Returns details for a specific device group."
        },
        {
          "info": {
            "name": "JFrog Delete Device Group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/projects/:projectId/device-groups/:groupId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Group ID"
              }
            ]
          },
          "docs": "Deletes a device group."
        }
      ]
    }
  ],
  "bundled": true
}