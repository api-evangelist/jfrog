{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Execution API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Execution",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Test Worker",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/workers/:workerKey/test",
            "params": [
              {
                "name": "workerKey",
                "value": "",
                "type": "path",
                "description": "Worker key identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Executes a worker with a test payload to validate its behavior."
        },
        {
          "info": {
            "name": "JFrog Get Worker Logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/workers/:workerKey/logs",
            "params": [
              {
                "name": "workerKey",
                "value": "",
                "type": "path",
                "description": "Worker key identifier"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "Start time for log retrieval"
              },
              {
                "name": "to",
                "value": "",
                "type": "query",
                "description": "End time for log retrieval"
              }
            ]
          },
          "docs": "Returns execution logs for a worker."
        }
      ]
    }
  ],
  "bundled": true
}