{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Violations API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Violations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Get Violations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/violations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns violations based on specified filters."
        }
      ]
    }
  ],
  "bundled": true
}