{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Summary API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Summary",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Get Artifact Summary",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/summary/artifact",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a summary of security issues and license information for specified artifacts."
        },
        {
          "info": {
            "name": "JFrog Get Build Summary",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/summary/build",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a summary of security issues for specified build."
        }
      ]
    }
  ],
  "bundled": true
}