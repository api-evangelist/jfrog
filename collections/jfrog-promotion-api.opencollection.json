{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Promotion API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Promotion",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Get Promotion Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v2/promotion/records/:name/:version",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ]
          },
          "docs": "Returns the promotion status and history for a release bundle version."
        },
        {
          "info": {
            "name": "JFrog Promote Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v2/promotion",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Promotes a release bundle to a target environment."
        }
      ]
    }
  ],
  "bundled": true
}