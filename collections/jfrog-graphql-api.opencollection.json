{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens GraphQL API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "GraphQL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Execute GraphQL Query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/custom/graphql",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Executes a GraphQL query against the JFrog Catalog. Supports querying packages, package versions, CVE information, license data, and custom labels. This is the primary interface for interacting with the Catalog service."
        }
      ]
    }
  ],
  "bundled": true
}