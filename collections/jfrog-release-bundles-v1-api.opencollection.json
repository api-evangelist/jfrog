{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Release Bundles V1 API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Release Bundles V1",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Release Bundles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/release_bundle"
          },
          "docs": "Returns a list of all release bundles."
        },
        {
          "info": {
            "name": "JFrog Create Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/release_bundle",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new release bundle with specified artifacts."
        },
        {
          "info": {
            "name": "JFrog Get Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/release_bundle/:name/:version",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ]
          },
          "docs": "Returns details for a specific release bundle version."
        },
        {
          "info": {
            "name": "JFrog Update Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{server}.jfrog.io/access/v1/release_bundle/:name/:version",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing release bundle."
        },
        {
          "info": {
            "name": "JFrog Delete Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/v1/release_bundle/:name/:version",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ]
          },
          "docs": "Deletes a release bundle version."
        },
        {
          "info": {
            "name": "JFrog Sign Release Bundle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/release_bundle/:name/:version/sign",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path",
                "description": "Release bundle name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Release bundle version"
              }
            ]
          },
          "docs": "Signs a release bundle, making it immutable and ready for distribution."
        }
      ]
    }
  ],
  "bundled": true
}