{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Replication API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Replication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List All Replications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/api/replications"
          },
          "docs": "Returns a list of all replication configurations."
        },
        {
          "info": {
            "name": "JFrog Get Replication Configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/api/replications/:repoKey",
            "params": [
              {
                "name": "repoKey",
                "value": "",
                "type": "path",
                "description": "Repository key"
              }
            ]
          },
          "docs": "Returns replication configuration for a specific repository."
        },
        {
          "info": {
            "name": "JFrog Create or Replace Replication",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{server}.jfrog.io/access/api/replications/:repoKey",
            "params": [
              {
                "name": "repoKey",
                "value": "",
                "type": "path",
                "description": "Repository key"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or replaces a replication configuration for a repository."
        },
        {
          "info": {
            "name": "JFrog Delete Replication",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/api/replications/:repoKey",
            "params": [
              {
                "name": "repoKey",
                "value": "",
                "type": "path",
                "description": "Repository key"
              }
            ]
          },
          "docs": "Removes a replication configuration."
        }
      ]
    }
  ],
  "bundled": true
}