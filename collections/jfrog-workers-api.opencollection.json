{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Workers API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Workers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/workers"
          },
          "docs": "Returns a list of all registered workers."
        },
        {
          "info": {
            "name": "JFrog Create Worker",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/v1/workers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new serverless worker with TypeScript code."
        },
        {
          "info": {
            "name": "JFrog Get Worker",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/v1/workers/:workerKey",
            "params": [
              {
                "name": "workerKey",
                "value": "",
                "type": "path",
                "description": "Worker key identifier"
              }
            ]
          },
          "docs": "Returns details for a specific worker."
        },
        {
          "info": {
            "name": "JFrog Update Worker",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{server}.jfrog.io/access/v1/workers/:workerKey",
            "params": [
              {
                "name": "workerKey",
                "value": "",
                "type": "path",
                "description": "Worker key identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing worker's code or configuration."
        },
        {
          "info": {
            "name": "JFrog Delete Worker",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{server}.jfrog.io/access/v1/workers/:workerKey",
            "params": [
              {
                "name": "workerKey",
                "value": "",
                "type": "path",
                "description": "Worker key identifier"
              }
            ]
          },
          "docs": "Deletes a worker."
        },
        {
          "info": {
            "name": "JFrog Enable Worker",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{server}.jfrog.io/access/v1/workers/:workerKey/enable",
            "params": [
              {
                "name": "workerKey",
                "value": "",
                "type": "path",
                "description": "Worker key identifier"
              }
            ]
          },
          "docs": "Enables a disabled worker."
        },
        {
          "info": {
            "name": "JFrog Disable Worker",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{server}.jfrog.io/access/v1/workers/:workerKey/disable",
            "params": [
              {
                "name": "workerKey",
                "value": "",
                "type": "path",
                "description": "Worker key identifier"
              }
            ]
          },
          "docs": "Disables an active worker."
        }
      ]
    }
  ],
  "bundled": true
}