{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Connect REST API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.connect.jfrog.io/v2/projects"
          },
          "docs": "Returns a list of all projects in the account."
        },
        {
          "info": {
            "name": "JFrog Create Project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.connect.jfrog.io/v2/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new project for organizing devices."
        },
        {
          "info": {
            "name": "JFrog Get Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.connect.jfrog.io/v2/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              }
            ]
          },
          "docs": "Returns details for a specific project."
        },
        {
          "info": {
            "name": "JFrog Delete Project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.connect.jfrog.io/v2/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              }
            ]
          },
          "docs": "Deletes a project."
        }
      ]
    },
    {
      "info": {
        "name": "Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Devices",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.connect.jfrog.io/v2/projects/:projectId/devices",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by device status"
              },
              {
                "name": "group_id",
                "value": "",
                "type": "query",
                "description": "Filter by device group"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              }
            ]
          },
          "docs": "Returns a list of all devices in a project."
        },
        {
          "info": {
            "name": "JFrog Get Device",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.connect.jfrog.io/v2/projects/:projectId/devices/:deviceId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "Device ID"
              }
            ]
          },
          "docs": "Returns details for a specific device."
        },
        {
          "info": {
            "name": "JFrog Remove Device",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.connect.jfrog.io/v2/projects/:projectId/devices/:deviceId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "Device ID"
              }
            ]
          },
          "docs": "Removes a device from the project."
        }
      ]
    },
