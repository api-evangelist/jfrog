          "http": {
            "method": "GET",
            "url": "https://api.connect.jfrog.io/v2/projects/:projectId/device-groups/:groupId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
