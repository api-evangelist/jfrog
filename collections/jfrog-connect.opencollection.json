                "description": "Group ID"
              }
            ]
          },
          "docs": "Returns details for a specific device group."
        },
        {
          "info": {
            "name": "JFrog Delete Device Group",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.connect.jfrog.io/v2/projects/:projectId/device-groups/:groupId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project ID"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "Group ID"
              }
            ]
          },
          "docs": "Deletes a device group."
        }
      ]
    },
    {
      "info": {
        "name": "Updates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog List Updates",
            "type": "http"
          },
          "http": {
