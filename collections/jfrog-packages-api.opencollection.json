{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Access REST Access Tokens Packages API",
    "version": "2.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Packages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Search Packages",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}.jfrog.io/access/packages/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches for packages across the catalog using various filter criteria including name, type, version, and labels."
        },
        {
          "info": {
            "name": "JFrog Get Package Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/packages/:packageType/:packageName",
            "params": [
              {
                "name": "packageType",
                "value": "",
                "type": "path",
                "description": "Package ecosystem type"
              },
              {
                "name": "packageName",
                "value": "",
                "type": "path",
                "description": "Package name (URL-encoded if contains special characters)"
              }
            ]
          },
          "docs": "Returns detailed metadata for a specific package, including versions, licenses, vulnerabilities, and custom labels."
        },
        {
          "info": {
            "name": "JFrog Get Package Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/packages/:packageType/:packageName/versions",
            "params": [
              {
                "name": "packageType",
                "value": "",
                "type": "path",
                "description": "Package ecosystem type"
              },
              {
                "name": "packageName",
                "value": "",
                "type": "path",
                "description": "Package name"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              }
            ]
          },
          "docs": "Returns all known versions of a specific package with their associated metadata, vulnerability counts, and license information."
        },
        {
          "info": {
            "name": "JFrog Get Version Vulnerabilities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}.jfrog.io/access/packages/:packageType/:packageName/versions/:version/vulnerabilities",
            "params": [
              {
                "name": "packageType",
                "value": "",
                "type": "path",
                "description": "Package ecosystem type"
              },
              {
                "name": "packageName",
                "value": "",
                "type": "path",
                "description": "Package name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path",
                "description": "Package version"
              },
              {
                "name": "severity",
                "value": "",
                "type": "query",
                "description": "Filter by minimum severity"
              }
            ]
          },
          "docs": "Returns all known CVEs affecting a specific package version, including both direct (non-transitive) and transitive vulnerabilities."
        }
      ]
    }
  ],
  "bundled": true
}