{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SystemHealth",
  "title": "SystemHealth",
  "type": "object",
  "properties": {
    "router": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "HEALTHY",
              "DEGRADED",
              "UNHEALTHY"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}