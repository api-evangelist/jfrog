{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/UpdateUserRequest",
  "title": "UpdateUserRequest",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string"
    },
    "admin": {
      "type": "boolean"
    },
    "profile_updatable": {
      "type": "boolean"
    },
    "disable_ui_access": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}