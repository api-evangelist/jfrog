{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/JPDRequest",
  "title": "JPDRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "token": {
      "type": "string",
      "description": "Admin access token for the JPD"
    },
    "location": {
      "type": "object",
      "properties": {
        "city_name": {
          "type": "string"
        },
        "country_code": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "name",
    "url",
    "token"
  ]
}