{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/SystemVersion",
  "title": "SystemVersion",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "example": "7.77.5"
    },
    "revision": {
      "type": "string",
      "example": "77700900"
    },
    "addons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string",
      "example": "Enterprise+"
    }
  }
}