{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CommandRequest",
  "title": "CommandRequest",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "The command to execute"
    },
    "device_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "default": 30
    }
  },
  "required": [
    "command"
  ]
}