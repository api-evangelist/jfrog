{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Model",
  "title": "Model",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "description": "ML framework (e.g., tensorflow, pytorch, sklearn)"
    },
    "task_type": {
      "type": "string",
      "description": "Type of ML task (e.g., classification, regression, nlp)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latest_version": {
      "type": "string"
    },
    "versions_count": {
      "type": "integer"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  }
}