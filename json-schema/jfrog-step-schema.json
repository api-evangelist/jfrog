{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Step",
  "title": "Step",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "pipelineId": {
      "type": "integer"
    },
    "runId": {
      "type": "integer"
    },
    "typeCode": {
      "type": "integer"
    },
    "statusCode": {
      "type": "integer"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "integer"
    }
  }
}