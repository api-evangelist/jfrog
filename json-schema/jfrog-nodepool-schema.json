{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/NodePool",
  "title": "NodePool",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "projectId": {
      "type": "integer"
    },
    "numberOfNodes": {
      "type": "integer"
    },
    "isOnDemand": {
      "type": "boolean"
    },
    "architecture": {
      "type": "string"
    },
    "operatingSystem": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}