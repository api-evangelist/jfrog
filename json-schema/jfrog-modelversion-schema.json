{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ModelVersion",
  "title": "ModelVersion",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "staging",
        "production",
        "archived"
      ]
    },
    "artifact_path": {
      "type": "string",
      "description": "Path to the model artifact in Artifactory"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Key-value pairs of model metrics (accuracy, loss, etc.)"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Hyperparameters used for training"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  }
}